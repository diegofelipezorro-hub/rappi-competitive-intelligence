# ── Scraping Mode ────────────────────────────────────────────────────────────
# "mock"       — uses synthetic data generator (default, no browser needed)
# "production" — runs real Playwright scrapers against live platforms
SCRAPING_MODE=mock

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Optional: Proxy services (uncomment if platforms start blocking) ──────────
# ScraperAPI (~$49/mes, 100k requests) — activate when Playwright gets blocked
# SCRAPERAPI_KEY=your_key_here

# Bright Data (~$500/mes for intensive use) — enterprise-grade proxy rotation
# BRIGHTDATA_USERNAME=your_username
# BRIGHTDATA_PASSWORD=your_password
# BRIGHTDATA_HOST=brd.superproxy.io
# BRIGHTDATA_PORT=22225

# ── Optional: Notification alerts ────────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# ── Dashboard ────────────────────────────────────────────────────────────────
# Port is set in .streamlit/config.toml (default: 8503)
# Override here if needed:
# STREAMLIT_PORT=8503
